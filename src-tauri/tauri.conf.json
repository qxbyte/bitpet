{
  "productName": "BitPet",
  "version": "1.0.3",
  "identifier": "dev.bitpet",
  "build": {
    "beforeDevCommand": "npm run vite:dev",
    "beforeBuildCommand": "npm run vite:build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "BitPet",
        "label": "main",
        "width": 110,
        "height": 150,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "visibleOnAllWorkspaces": true,
        "skipTaskbar": false,
        "shadow": false,
        "visible": true,
        "focus": true,
        "backgroundColor": "#00000000"
      }
    ],
    "macOSPrivateApi": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "resources": {
      "../cli/index.js": "cli/index.js",
      "../cli/bitpet-hook.js": "cli/bitpet-hook.js",
      "../cli/hooks-guide.js": "cli/hooks-guide.js",
      "../cli/package.json": "cli/package.json",
      "../cli/scripts/postinstall.js": "cli/scripts/postinstall.js"
    },
    "macOS": {
      "infoPlist": "./Info.plist"
    }
  }
}
